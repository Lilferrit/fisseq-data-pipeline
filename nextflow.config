// nextflow.config -- executor, profile and container settings ONLY.
//
// No default parameter values live here; those are in params.yaml, loaded
// explicitly:
//
//   nextflow run . --pipeline_dir /path/to/experiment -params-file params.yaml
//
// WARNING: do not reintroduce a top-level `params { }` block here, not even an
// empty one. Combined with -params-file, Nextflow's ConfigBuilder before
// 26.04.6 misattributes every params.yaml key into the `process{}` scope and
// fails with `Unknown config attribute 'params'`. Confirmed broken on 25.10.4,
// fixed in 26.04.6 -- but leaving the block out costs nothing and keeps older
// Nextflow working.
//
// NOTE: `workflow` does not exist at config-parse time -- use `projectDir`,
// never `workflow.projectDir`, in any profile block below.

docker {
    enabled = true
}

process {
    container = params.container_image
}

// Resource labels are declared by every process (process_low/process_medium/
// process_high) but deliberately sized by nobody here -- an executor profile
// that needs real cpus/memory/time supplies its own withLabel selectors. No
// profile currently consumes them, so this is inert.
profiles {
    // No container at all -- run against a local uv venv on PATH. Useful for
    // development and for the integration test suite.
    local {
        docker.enabled = false
        process.container = null
    }

    singularity {
        docker.enabled = false
        singularity.enabled = true
        singularity.autoMounts = true
    }

    // SGE (Sun Grid Engine) -- fill in queue name and adjust resources as
    // needed. Do not add personal cluster paths here; those belong in a
    // user-supplied `-c your.config`.
    // sge {
    //     process {
    //         executor       = 'sge'
    //         queue          = 'all.q'
    //         clusterOptions = '-V'
    //         cpus           = 4
    //         memory         = '16 GB'
    //         time           = '4h'
    //     }
    // }
}
