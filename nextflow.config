// nextflow.config — pass with: nextflow run your-org/fisseq-data-pipeline -c your.config -profile fowler_sge ...
//
// beforeScript options (add to the process block):
//   Option A: activate a pre-existing venv (recommended for shared clusters)
//     beforeScript = 'source /path/to/your/venv/bin/activate'
//   Option B: install from GitHub on each run (simpler, slower)
//     beforeScript = 'uv pip install git+https://github.com/your-org/fisseqtools.git@main --system'

params {
    // ── Pipeline selection ───────────────────────────────────────────────
    // "fisseq" | "ovwt"
    pipeline_mode = "fisseq"
    input_dir = null
    // optional: dir of YAML configs; each generates one input/*.parquet via
    // INPUT, merged with pre-staged files
    yaml_config_dir = null

    // ── Branch toggles ───────────────────────────────────────────────────
    // run OVWT_GLOBAL, BATCHVSBATCH, and the feature-selection global branch
    run_global = true
    // run the feature-selection branch (batchwise + global); if false, skip
    // AGGREGATE_FEATURE_TYPE/GENERATE_SPLIT/AGGREGATE_HALF/CORRELATE_FEATURES/
    // BLOCKLIST/COMBINE_BLOCKLISTS/FINALIZE_FEATURE_SELECT entirely
    run_feature_selection = true
    // FisseqPipeline only: run OVWT_BATCHWISE_UNFILTERED (the normal/
    // unfiltered per-batch OvWT pass). Set false to skip it for that batch --
    // since run_single_cell_scores/run_check_barcodes/run_barcode_filtered_ovwt
    // all consume its output, this also disables all three for that batch
    // regardless of their own settings. No effect in OvwtPipeline (its
    // entire purpose is this pass, so it always runs there).
    run_ovwt = true
    // run OVWT_BATCHWISE_FEATURE_FILTERED (per-batch OvWT filtered against
    // anova_blocklist/anova_blocklist.parquet); set false to skip it and
    // keep only the unfiltered pass. (renamed from run_filtered_ovwt)
    run_feature_filtered_ovwt = true
    // FisseqPipeline only: run OVWT_CELLSCORES_BATCHWISE per batch after
    // OVWT_BATCHWISE. Always on in OvwtPipeline. Forced on if
    // run_check_barcodes = true.
    run_single_cell_scores = false
    // Run CHECK_BARCODES (per-batch Tukey HSD of single-cell scores across
    // each variant's barcodes). Implies run_single_cell_scores = true --
    // see workflows/fisseq.nf.
    run_check_barcodes = false
    // Run OVWT_BATCHWISE_BARCODE_FILTERED (per-batch OvWT filtered against
    // barcode_blocklist/<batch>/barcode_blocklist.parquet). Only takes effect
    // when run_check_barcodes is also true (default false) -- does NOT force
    // run_check_barcodes on itself, so the default pipeline output is
    // unaffected -- see workflows/fisseq.nf.
    run_barcode_filtered_ovwt = true

    // ── INPUT stage tunables (optional YAML-driven variant selection) ────
    // These mirror src/fisseq_data_pipeline/input.py's per-batch YAML
    // schema (config_path) and now double as pipeline-wide defaults,
    // overridable per batch — see docs/nextflow.md's "Per-batch parameter
    // overrides".
    top_n_missense = null
    convert_first = false
    temp_dir = null
    feature_allowlist_file = null
    feature_blocklist_file = null

    // ── QC filtering (QC_FILTER) ─────────────────────────────────────────
    barcode_count_threshold = 10
    variant_barcode_count_threshold = 4
    edit_distance_threshold = 1
    // optional float (0,1]: QC_FILTER pseudo-variant downsampling, drawn
    // from post-QC cells; null = disabled
    qc_downsample_fraction = null
    // seed for the deterministic downsample selection
    qc_downsample_seed = 0

    // ── Batch-effect detection (ANOVA_BLOCKLIST) ─────────────────────────
    // features with p_value below this are blocked (significant batch effect)
    anova_blocklist_pvalue_threshold = 0.05

    // ── Barcode-level blocklist (BARCODE_BLOCKLIST) ───────────────────────
    // barcodes whose median p_adj (across CHECK_BARCODES pairwise
    // comparisons) is below this are blocked
    barcode_blocklist_pvalue_threshold = 0.05

    // ── Batch-vs-batch comparison (BATCHVSBATCH) ─────────────────────────
    batchvsbatch_min_cells = 50
    batchvsbatch_min_batches = 2

    // ── One-vs-wildtype classification (OVWT_GLOBAL / OVWT_BATCHWISE) ────
    ovwt_min_cells = 100
    ovwt_downsample_wt = 5000
    // optional int: cap any single wildtype/variant barcode's cell count,
    // downsampling that barcode alone; null disables the respective cap
    max_cells_per_barcode_wt = null
    max_cells_per_barcode_variant = null

    // ── Feature selection (bootstrap + aggregation + correlation) ────────
    // all _AGGREGATORS keys
    feature_select_types = ["mean", "median", "MAD", "std", "KS", "QQ", "AUROC"]
    feature_select_bootstrap_reps = 10
    // optional float (0,1) or int; null = no WT downsampling in
    // AGGREGATE_HALF/AGGREGATE_FEATURE_TYPE
    feature_select_downsample_wt = null
    feature_select_min_correlation = 0.5

    // ── Single-cell scoring & barcode QC (OVWT_CELLSCORES_BATCHWISE / CHECK_BARCODES) ──
    // "test" | "train": which OVWT_BATCHWISE split to score
    single_cell_scores_split = "test"
    // CHECK_BARCODES: min cells required per barcode (within a variant) to
    // include it in the comparison
    barcode_check_min_cells = 10
    // CHECK_BARCODES: family-wise significance level for Tukey HSD; a
    // barcode pair is flagged when its adjusted p-value is below this
    barcode_check_alpha = 0.05
}

// New feature-selection processes declare label 'process_low'/'process_medium'
// (nf-core-style) in preparation for a future SGE resource profile via
// withLabel selectors below. No profile currently consumes them, so this is
// inert — no functional change to today's runs.
profiles {
    // venv {
    //    process.beforeScript = "source ${projectDir}/../.venv/bin/activate"
    // }
    // conda {
    //     process.conda = "path/to/environment.yml"
    // }
    // singularity {
    //     singularity.enabled = true
    //     process.container = "path/to/image.sif"
    // }

    // SGE (Sun Grid Engine) — fill in queue name and adjust resources as needed.
    // Run with: nextflow run fisseq.nf -profile sge --input_dir /path/to/data
    // sge {
    //     process {
    //         executor       = 'sge'
    //         queue          = 'all.q'           // SGE queue name
    //         clusterOptions = '-V'              // forward current environment to each job
    //         cpus           = 4
    //         memory         = '16 GB'
    //         time           = '4h'
    //         beforeScript   = "source /path/to/.venv/bin/activate"
    //     }
    // }
}
